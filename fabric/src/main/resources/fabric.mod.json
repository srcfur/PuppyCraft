{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/puppy-craft",
        "sources": "https://github.com/srcfur/PuppyCraft",
        "irc": "https://fluxer.gg/0G3Vmb3m",
        "issues": "https://github.com/srcfur/PuppyCraft/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.srcfur.puppycraft.PuppyCraftFabric"
        ],
        "client": [
            "com.srcfur.puppycraft.PuppyCraftClientFabric"
        ],
        "fabric-datagen": [
            "com.srcfur.puppycraft.datagen.PuppyCraftDatagen"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  